# Copy to backend/.env and fill in REAL values (never commit backend/.env)

# LLM — set LLM_PROVIDER to "openai" or "gemini"
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Must match knowledge_entries.embedding vector(1536)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Supabase
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
DATABASE_URL=your_supabase_database_url_here

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Feature flags
MAX_CLARIFYING_QUESTIONS=4
USE_MOCK_LLM=true
# Set USE_MOCK_LLM=false after you plug in a real OPENAI_API_KEY

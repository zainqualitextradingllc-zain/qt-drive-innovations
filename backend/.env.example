# Copy to backend/.env and fill in real values

# LLM — set LLM_PROVIDER to "openai" or "gemini"
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
# Must match knowledge_entries.embedding vector(1536)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Feature flags
MAX_CLARIFYING_QUESTIONS=4
USE_MOCK_LLM=false
# Set USE_MOCK_LLM=true to demo chat without API keys

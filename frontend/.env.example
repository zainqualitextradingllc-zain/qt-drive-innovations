# Copy to frontend/.env.local (never commit .env.local)

# FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase (optional client-side; RAG runs on backend)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# PostHog (session_started + client funnel events; required for Live Events)
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxx

